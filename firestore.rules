rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll([
          'studentUid',
          'studentName',
          'questionId',
          'scenarioId',
          'questionText',
          'studentText',
          'timestamp',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'studentUid',
          'studentName',
          'questionId',
          'scenarioId',
          'scenarioTitle',
          'questionText',
          'studentText',
          'audioDataUrl',
          'timestamp',
          'createdAt',
          'updatedAt',
          'teacherScore',
          'teacherFeedback',
          'reviewedAt'
        ])
        && data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 60 && data.studentUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100
        && data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 64 && data.questionId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.scenarioId is int && data.scenarioId >= 1 && data.scenarioId <= 20
        && (!('scenarioTitle' in data) || (data.scenarioTitle is string && data.scenarioTitle.size() <= 200))
        && data.questionText is string && data.questionText.size() >= 1 && data.questionText.size() <= 500
        && data.studentText is string && data.studentText.size() <= 2000
        && (!('audioDataUrl' in data) || (data.audioDataUrl is string && data.audioDataUrl.size() <= 850000))
        && data.timestamp is int && data.timestamp > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('teacherScore' in data) || (data.teacherScore is number && data.teacherScore >= 0 && data.teacherScore <= 10))
        && (!('teacherFeedback' in data) || (data.teacherFeedback is string && data.teacherFeedback.size() <= 2000))
        && (!('reviewedAt' in data) || (data.reviewedAt is int && data.reviewedAt > 0));
    }

    // Read-only startup connectivity check
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // Cross-device student speaking submissions and teacher grading (no login required)
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId);
      allow list: if resource.data.scenarioId >= 1 && resource.data.scenarioId <= 20;

      allow create: if isValidId(submissionId)
        && isValidSubmission(incoming())
        && submissionId == (incoming().studentUid + '_' + incoming().questionId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !('teacherScore' in incoming())
        && !('teacherFeedback' in incoming())
        && !('reviewedAt' in incoming());

      allow update: if isValidId(submissionId)
        && isValidSubmission(incoming())
        && incoming().studentUid == existing().studentUid
        && incoming().questionId == existing().questionId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'studentName',
            'scenarioTitle',
            'questionText',
            'studentText',
            'audioDataUrl',
            'timestamp',
            'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'teacherScore',
            'teacherFeedback',
            'reviewedAt',
            'updatedAt'
          ])
        );

      allow delete: if isValidId(submissionId);
    }
  }
}
