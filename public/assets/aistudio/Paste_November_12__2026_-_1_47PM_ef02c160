<script>
(function(){
  'use strict';

  /* ---------- SPEECH SYNTHESIS SETUP ---------- */
  let zhVoice = null;
  let currentRate = 1;

  function loadVoices(){
    if(!('speechSynthesis' in window)) return;
    const voices = speechSynthesis.getVoices();
    zhVoice = voices.find(function(v){ return /^zh[-_]CN/i.test(v.lang); })
           || voices.find(function(v){ return /^zh/i.test(v.lang); })
           || null;
    const status = document.getElementById('voiceStatus');
    if(status){
      if(zhVoice){
        status.textContent = '✓ Giọng đọc: ' + zhVoice.name;
        status.className = 'voice-status ok';
      } else if(voices.length){
        status.textContent = '⚠ Không tìm thấy giọng Trung, dùng giọng mặc định';
        status.className = 'voice-status warn';
      }
    }
  }

  if('speechSynthesis' in window){
    speechSynthesis.onvoiceschanged = loadVoices;
    loadVoices();
    setTimeout(loadVoices, 300);
    setTimeout(loadVoices, 1000);
    setTimeout(loadVoices, 2500);
  } else {
    const status = document.getElementById('voiceStatus');
    if(status){
      status.textContent = '⚠ Trình duyệt không hỗ trợ phát âm thanh';
      status.className = 'voice-status warn';
    }
  }

  function makeUtterance(text){
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'zh-CN';
    u.rate = currentRate;
    if(zhVoice) u.voice = zhVoice;
    return u;
  }

  function stopAll(){
    if('speechSynthesis' in window) speechSynthesis.cancel();
    document.querySelectorAll('.speaking').forEach(function(el){
      el.classList.remove('speaking');
    });
  }

  /* ---------- PLAY INDIVIDUAL LINE ---------- */
  document.querySelectorAll('.play-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      if(!('speechSynthesis' in window)){
        alert('Trình duyệt của bạn không hỗ trợ phát âm thanh.');
        return;
      }
      const text = btn.getAttribute('data-text');
      if(!text) return;
      stopAll();
      const u = makeUtterance(text);
      btn.classList.add('speaking');
      u.onend = function(){ btn.classList.remove('speaking'); };
      u.onerror = function(){ btn.classList.remove('speaking'); };
      speechSynthesis.speak(u);
    });
  });

  /* ---------- PLAY WHOLE SECTION ---------- */
  document.querySelectorAll('.btn-play-all').forEach(function(btn){
    btn.addEventListener('click', function(){
      if(!('speechSynthesis' in window)){
        alert('Trình duyệt của bạn không hỗ trợ phát âm thanh.');
        return;
      }
      const targetId = btn.getAttribute('data-target');
      const container = document.getElementById(targetId);
      if(!container) return;
      const lines = container.querySelectorAll('.d-cn');
      if(!lines.length) return;

      stopAll();
      btn.classList.add('speaking');

      lines.forEach(function(line, i){
        const clone = line.cloneNode(true);
        const sp = clone.querySelector('.speaker');
        if(sp) sp.remove();
        const text = clone.textContent.trim();
        if(!text) return;
        const u = makeUtterance(text);
        if(i === lines.length - 1){
          u.onend = function(){ btn.classList.remove('speaking'); };
          u.onerror = function(){ btn.classList.remove('speaking'); };
        }
        speechSynthesis.speak(u);
      });
    });
  });

  /* ---------- STOP BUTTONS ---------- */
  document.querySelectorAll('.stop-all, .btn-stop').forEach(function(btn){
    btn.addEventListener('click', stopAll);
  });

  /* ---------- SPEED CONTROL ---------- */
  document.querySelectorAll('.rate-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.rate-btn').forEach(function(b){
        b.classList.remove('active');
      });
      btn.classList.add('active');
      currentRate = parseFloat(btn.getAttribute('data-rate'));
    });
  });

  /* ---------- FULL DIALOGUE TOGGLE ---------- */
  document.querySelectorAll('.full-dialogue-toggle').forEach(function(btn){
    btn.addEventListener('click', function(){
      const wrap = document.getElementById(btn.getAttribute('data-target'));
      if(!wrap) return;
      const hidden = wrap.classList.toggle('hidden');
      btn.textContent = hidden
        ? '🎬 Xem toàn bộ hội thoại mẫu (mở rộng)'
        : '🙈 Ẩn hội thoại mẫu';
    });
  });

  /* ---------- ACCORDION ---------- */
  document.querySelectorAll('.scenario-head').forEach(function(head){
    head.addEventListener('click', function(){
      const card = head.parentElement;
      const wasOpen = card.classList.contains('open');
      document.querySelectorAll('.scenario').forEach(function(c){
        c.classList.remove('open');
      });
      if(!wasOpen){ card.classList.add('open'); }
    });
  });

  /* ---------- SMOOTH SCROLL NAV ---------- */
  document.querySelectorAll('.nav-inner a').forEach(function(a){
    a.addEventListener('click', function(e){
      const target = document.querySelector(this.getAttribute('href'));
      if(target){
        e.preventDefault();
        target.scrollIntoView({behavior:'smooth', block:'start'});
      }
    });
  });

  /* ---------- AUTO-SAVE NOTES (localStorage) ---------- */
  document.querySelectorAll('.answer-input[data-note-key]').forEach(function(ta){
    const key = 'airport-notes-' + ta.getAttribute('data-note-key');
    try{
      const saved = localStorage.getItem(key);
      if(saved) ta.value = saved;
    }catch(e){}
    ta.addEventListener('input', function(){
      try{ localStorage.setItem(key, ta.value); }catch(e){}
    });
  });

})();
</script>

